<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>KeeperSpawner</AssemblyName>
    <RootNamespace>KeeperSpawner</RootNamespace>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <ManagedPath>$(GamePath)\GraveyardKeeper2_Data\Managed</ManagedPath>
    <BepInExCorePath>$(GamePath)\BepInEx\core</BepInExCorePath>
    <PluginDeployPath>$(GamePath)\BepInEx\plugins\KeeperSpawner</PluginDeployPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.7.2 targeting pack kurulu olmadan derleyebilmek için -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Oyun ve BepInEx DLL'leri doğrudan oyun klasöründen referans alınır, çıktıya kopyalanmaz -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LazyBearTechnology">
      <HintPath>$(ManagedPath)\LazyBearTechnology.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GamePath)' == ''"
           Text="GamePath tanımlı değil. Repo kökünde Directory.Build.props.user oluşturup GamePath'i oyun klasörüne ayarla." />
    <Error Condition="!Exists('$(ManagedPath)\Assembly-CSharp.dll')"
           Text="Oyun DLL'leri bulunamadı: $(ManagedPath)" />
    <Error Condition="!Exists('$(BepInExCorePath)\BepInEx.dll')"
           Text="BepInEx bulunamadı: $(BepInExCorePath). Önce BepInEx 5'i oyuna kur." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDeployPath)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="KeeperSpawner -> $(PluginDeployPath)" />
  </Target>

</Project>
