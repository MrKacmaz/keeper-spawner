<Project>
  <!-- GamePath yerel dosyada tanımlanır (git'e girmez). Örnek:
       <Project><PropertyGroup><GamePath>C:\...\Graveyard Keeper 2</GamePath></PropertyGroup></Project> -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
</Project>
